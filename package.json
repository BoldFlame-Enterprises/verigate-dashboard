{
  "name": "accreditation-web-dashboard",
  "version": "1.0.0",
  "description": "Admin Web Dashboard for QR Code Accreditation System",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run build:bundle-budget",
    "build:bundle-budget": "node scripts/check-bundle-budget.mjs",
    "preview": "vite preview",
    "audit:dependencies": "npm audit --audit-level=moderate",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "vitest run src",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.0",
    "@tanstack/react-query": "^4.35.0",
    "axios": "^1.5.0",
    "clsx": "^2.0.0",
    "lucide-react": "^0.279.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.46.0",
    "react-router-dom": "7.18.2",
    "recharts": "^2.8.0",
    "tailwind-merge": "^1.14.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.8.0",
    "@types/react": "^18.2.22",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "^10.4.15",
    "eslint": "8.57.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "jsdom": "^29.1.1",
    "postcss": "8.5.26",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.2.2",
    "vite": "8.2.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.14.0 <23",
    "npm": "10.9.2"
  },
  "packageManager": "npm@10.9.2"
}
